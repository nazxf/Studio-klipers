# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js / NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# App
NODE_ENV="development"

# Optional local media tool overrides.
# Defaults use PATH lookup. Set these only if Node cannot spawn the PATH commands.
FFMPEG_PATH=""
FFPROBE_PATH=""

# Future optional production storage/queue (not required for the local MVP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_URL=""
REDIS_URL=""
